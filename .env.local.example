NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Az oldal megbízható, fix origin-je (protokollal, záró "/" nélkül),
# pl. "https://idopontneked.hu". Kötelező production/preview Vercel
# környezetekben — az auth-emailekben (jelszó-visszaállítás, magic link,
# email-cím módosítás) küldött linkek ebből épülnek fel, nem a request
# Host fejlécéből (ami elméletileg hamisítható, "password reset
# poisoning" kockázatot jelentene). Helyi fejlesztéshez elhagyható,
# ilyenkor a kérés Host fejléce a fallback (pl. "http://localhost:3000").
NEXT_PUBLIC_SITE_URL=

# Lemondás-értesítő emailek küldéséhez (app/dashboard/actions.ts -> cancelBookingAction).
# Kötelező: hozz létre egy fiókot a https://resend.com oldalon, majd generálj API kulcsot.
# Enélkül a lemondás továbbra is működik, csak email nem megy ki a vendégnek.
RESEND_API_KEY=

# Opcionális, a Resend fiókban ELŐZETESEN VERIFIKÁLT domainhez tartozó feladó cím.
# Verifikálatlan domainnel a Resend elutasítja a küldést. Ha üresen hagyod,
# az alapértelmezett "IdőpontNeked.hu <foglalas@idopontneked.hu>" kerül használatra
# (ez csak akkor működik, ha az idopontneked.hu domain verifikálva van a Resend fiókban).
RESEND_FROM_EMAIL=
